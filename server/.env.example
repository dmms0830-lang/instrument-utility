# server/.env.example
# 이 파일을 복사해서 같은 폴더에 ".env" 로 저장하고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 의해 깃에 올라가지 않습니다 (키 보호).

# 새로 발급한 Anthropic API 키 (https://console.anthropic.com/ → API Keys)
ANTHROPIC_API_KEY=

# 사용할 모델 (빠르고 저렴: haiku / 더 똑똑: claude-sonnet-4-6)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# 한 응답당 최대 토큰
MAX_TOKENS=1024

# 서버 포트
PORT=8787

# 허용할 프론트엔드 주소. 배포 후 본인 Vercel 주소로 바꾸세요 (도용 방지).
# 예) https://instrument-utility.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*
